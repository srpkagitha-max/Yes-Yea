rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    match /admins/{uid} { allow read, create, update, delete: if isAdmin(); }
    match /institutes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /batches/{id} { allow read: if true; allow write: if isAdmin(); }
    match /studentMaster/{id} { allow read, write: if isAdmin(); }
    match /questionBank/{id} { allow read, write: if isAdmin(); }
    match /questionBankSubjects/{id} { allow read, write: if isAdmin(); }
    match /exams/{examId} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /examQuestions/{examId} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /studentAccess/{accessId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'studentName','mobile','hallTicket','status','startedAt','lastLoginAt','completedAt',
          'resultScore','cloudAnswers','cloudReview','currentQuestion','totalQuestions','answeredCount',
          'unansweredCount','remainingSeconds','lastActivityAt','connectionState','sessionVersion'
        ]) && request.resource.data.status in ['unused','inProgress','completed']
      );
    }
    match /results/{resultId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.examId is string
        && request.resource.data.score is number && request.resource.data.total is number
        && request.resource.data.score >= 0 && request.resource.data.total >= 0
        && request.resource.data.score <= request.resource.data.total;
      allow update, delete: if isAdmin();
    }
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.examId is string
        && request.resource.data.name is string && request.resource.data.score is number
        && request.resource.data.total is number && request.resource.data.percent is number
        && request.resource.data.score >= 0 && request.resource.data.total >= 0
        && request.resource.data.score <= request.resource.data.total;
      allow update, delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
